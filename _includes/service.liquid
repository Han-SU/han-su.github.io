<div class="service">
  {% if site.service != blank %}
    <ul style="list-style-type: none; padding-left: 0;">
      {% assign items = site.service | sort: 'order' %}
      {% for item in items %}
        <li>
          <strong>{{ item.title }}:</strong> {{ item.content | markdownify | strip_html | strip_newlines }}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No service entries found.</p>
  {% endif %}
</div>